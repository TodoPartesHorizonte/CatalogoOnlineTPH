/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self' https: data: 'unsafe-inline' 'unsafe-eval'; upgrade-insecure-requests;
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  X-XSS-Protection: 1; mode=block

# Regla global: HTML y páginas siempre en vivo (0 segundos de caché, instantáneo)
/*
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

# Base de datos del catálogo en vivo
/products.js
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

# Scripts principales
/app.js
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/app.min.js
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

# Recursos estáticos inmutables (fotos de repuestos, logos y fuentes)
/assets/*
  ! Cache-Control
  Cache-Control: max-age=31536000, immutable
